.creds.txt
# Build artefacts from a local `uv build`
requirements.lock.txt
# Generated by `uv export`. The Dockerfile runs that export itself during
# the build, so a committed copy is never read, only left to rot: it drifts
# from uv.lock and draws dependency bots to a file nothing installs.
dockerreq.txt
coverage.xml
